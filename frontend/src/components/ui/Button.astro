---
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"button"> {
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md" | "lg";
  href?: string;
}
const {
  variant = "primary",
  size = "md",
  href,
  class: cls,
  ...rest
} = Astro.props;
---

{href ? (
  <a
    href={href}
    class:list={["button", `button--${variant}`, `button--${size}`, cls]}
    {...rest}
  >
    <slot />
  </a>
) : (
  <button
    class:list={["button", `button--${variant}`, `button--${size}`, cls]}
    {...rest}
  >
    <slot />
  </button>
)}
