---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
}
const { title, description, eyebrow } = Astro.props;
---

<div class="credit-page-heading">
  <div>
    {eyebrow && <p class="credit-eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {description && <p>{description}</p>}
  </div>
  <slot />
</div>
