---
import Layout from "../../layouts/CabinetLayout.astro";
import Heading from "../../components/cabinet/PageHeading.astro";
import RequestCard from "../../components/cabinet/RequestCard.astro";
import { Button, Icon } from "../../components/ui";
import { demoRequests } from "../../data/cabinet";
---

<Layout title="Мои заявки" active="applications">
  <Heading
    title="Мои заявки"
    description="Статус, условия и следующие шаги по каждому обращению."
  >
    <Button href="/cabinet/new/">
      Новая заявка <span>+</span>
    </Button>
  </Heading>
  <div class="request-toolbar">
    <div class="credit-filters" role="group" aria-label="Фильтр заявок">
      <button aria-pressed="true" data-filter="all">
        Все <span data-total-count>3</span>
      </button>
      <button aria-pressed="false" data-filter="bank_review">
        На рассмотрении
      </button>
      <button aria-pressed="false" data-filter="needs_info">
        Нужны данные
      </button>
      <button aria-pressed="false" data-filter="approved">
        С предложением
      </button>
    </div>
    <label class="credit-search">
      <Icon name="search" size={19} />
      <input
        type="search"
        placeholder="Номер или цель заявки"
        aria-label="Поиск заявок"
        data-request-search
      />
    </label>
  </div>
  <div class="request-grid request-grid--list" data-request-list>
    {demoRequests.map((request) => (
      <RequestCard request={request} />
    ))}
  </div>
  <div class="credit-empty credit-white-card" data-empty-requests hidden>
    <Icon name="search" size={32} />
    <h3>Таких заявок пока нет</h3>
    <p>Измените фильтр или поисковый запрос.</p>
    <button class="credit-text-link" data-reset-filter>
      Показать все заявки
    </button>
  </div>
  <p class="credit-footnote">
    Показаны синтетические заявки и заявки, созданные вами в этом браузере.
  </p>
</Layout>
