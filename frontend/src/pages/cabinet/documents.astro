---
import Layout from "../../layouts/CabinetLayout.astro";
import Heading from "../../components/cabinet/PageHeading.astro";
import { Icon } from "../../components/ui";
---

<Layout title="Документы" active="documents">
  <Heading
    title="Документы"
    description="Сведения о компании и файлы для ваших заявок."
  />
  <section class="credit-white-card credit-upload-card">
    <div>
      <span class="request-symbol">
        <Icon name="upload" size={25} />
      </span>
      <h2>Добавьте документ</h2>
      <p>
        В демо сохраняем только название и размер файла.
        <br />
        Содержимое не читается и не отправляется на сервер.
      </p>
    </div>
    <label class="credit-upload">
      <Icon name="upload" size={27} />
      <strong>Выберите файл</strong>
      <span>PDF, DOCX, XLSX, CSV, TXT, JSON · до 5 МБ</span>
      <input
        type="file"
        accept=".pdf,.docx,.xlsx,.csv,.txt,.json"
        aria-label="Выбрать документ"
        data-credit-upload
      />
    </label>
  </section>
  <section class="credit-section">
    <div class="credit-section-head">
      <h2>Документы компании</h2>
      <span class="credit-footnote">Синтетические примеры</span>
    </div>
    <div class="credit-white-card credit-documents-list" data-documents-list>
      <div class="document-row">
        <span class="document-file-type">XLS</span>
        <div>
          <strong>Управленческая отчётность.xlsx</strong>
          <small>Пример · 128 КБ · 21 октября 2026</small>
        </div>
        <span class="status-pill status-approved">Пример документа</span>
        <button
          class="credit-icon-action"
          aria-label="Информация об отчётности"
          data-document-info
        >
          <Icon name="chevron" size={18} />
        </button>
      </div>
      <div class="document-row">
        <span class="document-file-type document-pdf">PDF</span>
        <div>
          <strong>Сведения о компании.pdf</strong>
          <small>Пример · 240 КБ · 18 октября 2026</small>
        </div>
        <span class="status-pill status-approved">Пример документа</span>
        <button
          class="credit-icon-action"
          aria-label="Информация о сведениях компании"
          data-document-info
        >
          <Icon name="chevron" size={18} />
        </button>
      </div>
    </div>
  </section>
</Layout>
