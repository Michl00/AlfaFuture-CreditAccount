---
import Layout from "../../layouts/CabinetLayout.astro";
import Heading from "../../components/cabinet/PageHeading.astro";
import { Button, Icon } from "../../components/ui";
---

<Layout title="Кабинет сотрудника" active="bank">
  <Heading
    title="Очередь заявок"
    description="Демо рабочего места: рассмотрение, уточнения и история действий."
  >
    <Button href="/cabinet/" variant="secondary">
      Кабинет клиента ↗
    </Button>
  </Heading>
  <div class="credit-info-note bank-demo-note">
    <Icon name="shield" size={20} />
    <span>
      Это переключатель экранов для демонстрации, а не авторизация сотрудника.
      Все действия меняют только синтетические данные этого браузера.
    </span>
  </div>
  <div class="credit-bank-layout">
    <section class="credit-white-card">
      <div class="credit-section-head">
        <h2>Ожидают внимания</h2>
        <span class="credit-footnote">Демо-очередь</span>
      </div>
      <div data-bank-queue></div>
    </section>
    <section class="credit-white-card credit-bank-detail" data-bank-detail>
      <span class="credit-eyebrow">КАРТОЧКА ЗАЯВКИ</span>
      <h2 data-bank-title>Выберите заявку</h2>
      <dl class="credit-review" data-bank-summary></dl>
      <div class="credit-info-note">
        <Icon name="shield" size={20} />
        <span>
          Скоринговая оценка не рассчитывается. Ниже — только симуляция действий
          сотрудника.
        </span>
      </div>
      <form id="bank-action-form">
        <label class="credit-field">
          <span>Комментарий к действию</span>
          <textarea
            name="comment"
            required
            rows="3"
            placeholder="Укажите причину или необходимые уточнения"
          ></textarea>
        </label>
        <div class="credit-bank-actions">
          <Button
            type="submit"
            name="action"
            value="needs_info"
            variant="secondary"
          >
            Запросить уточнение
          </Button>
          <Button type="submit" name="action" value="approved">
            Предложить условия
          </Button>
        </div>
      </form>
      <p class="credit-footnote" data-bank-history></p>
    </section>
  </div>
</Layout>
