---
import Layout from "../../layouts/CabinetLayout.astro";
import { Button, Icon } from "../../components/ui";
---

<Layout title="Заявка на финансирование" active="applications">
  <div data-application-detail>
    <a class="credit-back" href="/cabinet/applications/">
      ← Мои заявки
    </a>
    <div class="credit-page-heading">
      <div>
        <p class="credit-eyebrow" data-detail-id>
          ЗАЯВКА № AF-1024
        </p>
        <h1 data-detail-title>На развитие бизнеса</h1>
        <p data-detail-date>Создана 23 октября 2026</p>
      </div>
      <span data-detail-status></span>
    </div>
    <div class="credit-detail-grid">
      <div>
        <section class="credit-white-card credit-detail-state">
          <div class="credit-state-icon">
            <Icon name="clock" size={28} />
          </div>
          <h2 data-detail-state-title>Рассматриваем вашу заявку</h2>
          <p data-detail-state-text>
            Данные получены. Следите за статусом — здесь появится результат или
            запрос уточнения.
          </p>
          <div class="credit-status-timeline">
            <div class="is-done">
              <span>
                <Icon name="check" size={15} />
              </span>
              <strong>Заявка создана</strong>
              <small>Данные сохранены</small>
            </div>
            <div class="is-current">
              <span>2</span>
              <strong>Рассмотрение</strong>
              <small>Проверка данных компании</small>
            </div>
            <div>
              <span>3</span>
              <strong>Решение</strong>
              <small>Условия и следующий шаг</small>
            </div>
          </div>
        </section>
        <section
          class="credit-white-card credit-clarification"
          data-clarification
          hidden
        >
          <span class="status-pill status-needs_info">Нужно уточнение</span>
          <h2>Уточните выручку компании</h2>
          <p>
            Укажите выручку за последние три месяца и добавьте комментарий. Это
            демонстрационный запрос сотрудника.
          </p>
          <form id="clarification-form">
            <label class="credit-field">
              <span>Ваш комментарий</span>
              <textarea
                name="clarification"
                rows="3"
                required
                placeholder="Например, выручка за июль, август и сентябрь…"
              ></textarea>
            </label>
            <Button type="submit">Отправить уточнение →</Button>
          </form>
        </section>
        <section class="credit-white-card credit-detail-company">
          <h2>Данные заявки</h2>
          <dl class="credit-review">
            <div>
              <dt>Компания</dt>
              <dd data-detail-company>ООО «Пример роста»</dd>
            </div>
            <div>
              <dt>Цель</dt>
              <dd data-detail-goal>Открыть вторую кофейню</dd>
            </div>
            <div>
              <dt>Результаты проверок</dt>
              <dd>Будут получены при интеграции</dd>
            </div>
          </dl>
          <p class="credit-footnote">
            Реальные внешние проверки и скоринг в дизайне-демо не выполняются.
          </p>
        </section>
      </div>
      <aside>
        <section class="credit-white-card credit-detail-terms">
          <h3>Условия финансирования</h3>
          <p class="summary-label">Запрошенная сумма</p>
          <strong class="summary-amount" data-detail-amount>
            2 000 000 ₽
          </strong>
          <dl>
            <div>
              <dt>Срок</dt>
              <dd data-detail-months>24 месяца</dd>
            </div>
            <div>
              <dt>Условная ставка</dt>
              <dd data-detail-rate>24,9% годовых</dd>
            </div>
          </dl>
          <div class="summary-payment">
            <span>Примерный платёж в месяц</span>
            <strong data-detail-payment>106 643 ₽</strong>
          </div>
          <p class="credit-footnote">Демонстрационные условия.</p>
        </section>
        <div class="credit-detail-help">
          <Icon name="shield" size={20} />
          <p>
            Вся история — в одном месте.
            <br />
            Никаких звонков для прохождения демо.
          </p>
        </div>
      </aside>
    </div>
  </div>
</Layout>
