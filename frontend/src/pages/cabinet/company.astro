---
import Layout from "../../layouts/CabinetLayout.astro";
import Heading from "../../components/cabinet/PageHeading.astro";
import Field from "../../components/cabinet/CreditField.astro";
import { Button, Icon } from "../../components/ui";
---

<Layout title="Моя компания" active="company">
  <Heading
    title="Моя компания"
    description="Данные бизнеса, которые используются при заполнении заявки."
  />
  <div class="credit-detail-grid">
    <section class="credit-white-card credit-company-form">
      <div class="credit-company-heading">
        <span class="company-avatar">ПР</span>
        <div>
          <h2 data-company-name>ООО «Пример роста»</h2>
          <p>Демонстрационная компания</p>
        </div>
      </div>
      <form id="credit-company-form">
        <div class="form-grid">
          <Field
            label="Название компании"
            name="company"
            value="ООО «Пример роста»"
            required
          />
          <Field
            label="ИНН"
            name="inn"
            value="7701234560"
            pattern="[0-9]{10}|[0-9]{12}"
            maxlength="12"
            required
          />
          <Field
            label="Представитель"
            name="representative"
            value="Алексей Примеров"
            required
          />
          <Field
            label="Электронная почта"
            name="email"
            value="demo@example.com"
            type="email"
            required
          />
        </div>
        <Button type="submit">Сохранить изменения</Button>
      </form>
    </section>
    <aside class="credit-company-note">
      <Icon name="shield" size={26} />
      <h3>
        Ваши данные
        <br />
        под контролем
      </h3>
      <p>В этом демо изменения сохраняются только в браузере.</p>
      <p>
        Используйте вымышленные данные. Настоящая авторизация и серверный
        профиль подключаются на следующем этапе.
      </p>
    </aside>
  </div>
</Layout>
