---
import Layout from "../../layouts/CabinetLayout.astro";
import Heading from "../../components/cabinet/PageHeading.astro";
import Field from "../../components/cabinet/CreditField.astro";
import Progress from "../../components/cabinet/CreditProgress.astro";
import { Button, Icon } from "../../components/ui";
---

<Layout title="Новая заявка" active="applications">
  <a class="credit-back" href="/cabinet/applications/">
    ← Заявки
  </a>
  <Heading title="Заявка на финансирование" />
  <div class="credit-form-layout">
    <div class="credit-form-column">
      <form id="credit-form" novalidate>
        <div data-credit-step="0">
          <div class="credit-white-card credit-form-card">
            <span class="credit-record-label">НОВОЕ</span>
            <h2>Условия финансирования</h2>
            <Field
              label="Цель кредита"
              name="purpose"
              value="growth"
              options={[
                { value: "working", label: "Оборотные средства" },
                { value: "equipment", label: "Покупка оборудования" },
                { value: "growth", label: "Развитие бизнеса" },
              ]}
            />
            <div class="form-grid">
              <Field
                label="Сумма заявки, ₽"
                name="amount"
                type="number"
                min="100000"
                max="10000000"
                step="50000"
                value="2000000"
                required
              />
              <Field
                label="Срок кредита"
                name="months"
                value="24"
                options={[
                  { value: "12", label: "12 месяцев" },
                  { value: "24", label: "24 месяца" },
                  { value: "36", label: "36 месяцев" },
                  { value: "48", label: "48 месяцев" },
                  { value: "60", label: "60 месяцев" },
                ]}
              />
            </div>
            <label class="credit-field">
              <span>Расскажите о задаче бизнеса</span>
              <textarea
                name="goal"
                rows="3"
                placeholder="Например, открыть вторую кофейню"
              >Хочу открыть вторую кофейню и купить оборудование</textarea>
            </label>
            <p class="credit-form-subheading">Как подать заявку</p>
            <div class="credit-source-callout">
              Сначала выберите параметры и сравните варианты. Затем добавьте
              данные компании и проверьте заявку перед отправкой.
            </div>
          </div>
          <div class="credit-form-actions">
            <Button type="button" data-credit-next>
              Продолжить
            </Button>
            <Button type="button" variant="secondary" data-save-draft>
              Сохранить черновик
            </Button>
          </div>
        </div>
        <div data-credit-step="1" hidden>
          <div class="credit-white-card credit-form-card">
            <h2>Выберите подходящий вариант</h2>
            <p class="credit-form-lead">
              Два примера условий для сравнения. Это демонстрационный подбор.
            </p>
            <div class="credit-offers" data-credit-offers></div>
            <div class="credit-info-note">
              <Icon name="shield" size={20} />
              <span>
                Предварительный расчёт. Условия в этом демо не являются
                предложением банка.
              </span>
            </div>
          </div>
          <div class="credit-form-actions">
            <Button type="button" variant="secondary" data-credit-prev>
              Назад
            </Button>
            <Button type="button" data-credit-next>
              Продолжить →
            </Button>
          </div>
        </div>
        <div data-credit-step="2" hidden>
          <div class="credit-white-card credit-form-card">
            <h2>Расскажите о компании</h2>
            <p class="credit-form-lead">
              Мы уже заполнили пример. Используйте только вымышленные данные.
            </p>
            <div class="form-grid">
              <Field
                label="Название компании"
                name="company"
                value="ООО «Пример роста»"
                required
              />
              <Field
                label="ИНН"
                name="inn"
                value="7701234560"
                inputmode="numeric"
                maxlength="12"
                required
                hint="В демо проверяем только формат"
              />
              <Field
                label="Выручка в месяц, ₽"
                name="revenue"
                type="number"
                value="1500000"
                required
              />
              <Field
                label="Расходы в месяц, ₽"
                name="expenses"
                type="number"
                value="900000"
                required
              />
              <Field
                label="Платежи по кредитам, ₽ / мес."
                name="debt"
                type="number"
                value="50000"
                required
              />
              <Field
                label="Возраст бизнеса, месяцев"
                name="age"
                type="number"
                value="36"
                required
              />
            </div>
          </div>
          <div class="credit-form-actions">
            <Button type="button" variant="secondary" data-credit-prev>
              Назад
            </Button>
            <Button type="button" data-credit-next>
              Проверить данные →
            </Button>
          </div>
        </div>
        <div data-credit-step="3" hidden>
          <div class="credit-white-card credit-form-card">
            <h2>Всё верно?</h2>
            <p class="credit-form-lead">
              Проверьте данные перед созданием демо-заявки.
            </p>
            <dl class="credit-review" data-credit-review></dl>
            <div class="credit-info-note">
              <Icon name="shield" size={20} />
              <span>
                Это предварительные условия. В настоящем процессе окончательное
                решение принимает сотрудник банка.
              </span>
            </div>
            <label class="credit-consent">
              <input type="checkbox" name="consent" />
              <span>
                Подтверждаю данные и создание учебной заявки. Понимаю, что в
                этом демо она не отправляется в банк.
              </span>
            </label>
          </div>
          <div class="credit-form-actions">
            <Button type="button" variant="secondary" data-credit-prev>
              Изменить данные
            </Button>
            <Button type="submit">
              Создать демо-заявку <Icon name="arrow" size={18} />
            </Button>
          </div>
        </div>

        <p class="credit-error" role="alert" hidden></p>
      </form>
      <section
        class="credit-white-card credit-success"
        data-credit-success
        hidden
      >
        <span>
          <Icon name="check" size={32} />
        </span>
        <h2>Заявка создана</h2>
        <p>Статус и дальнейшие действия доступны в разделе «Заявки».</p>
        <a
          class="button button--primary"
          data-created-link
          href="/cabinet/applications/"
        >
          Посмотреть заявку
        </a>
        <a class="credit-text-link" href="/cabinet/">
          К кредитным продуктам
        </a>
      </section>
    </div>
    <div class="credit-form-aside">
      <Progress />
      <p class="credit-save-caption">
        Черновик сохраняется
        <br />в этом браузере.
      </p>
      <button class="credit-text-link" data-credit-clear>
        Очистить черновик
      </button>
    </div>
  </div>
</Layout>
