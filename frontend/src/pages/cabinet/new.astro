---
import Layout from "../../layouts/ProductLayout.astro";
---

<Layout title="Новая заявка" screen="new">
  <a class="credit-back" href="/cabinet/" data-application-back>
    ← К продуктам
  </a>
  <div class="product-heading">
    <div>
      <p class="product-eyebrow">ФИНАНСИРОВАНИЕ БИЗНЕСА</p>
      <h1 data-application-title>Новая заявка</h1>
      <p data-application-description>
        Проверьте условия и устойчивость бизнеса до отправки
      </p>
    </div>
    <a
      class="button button--secondary"
      href="/cabinet/assistant/"
      data-application-assistant
    >
      Помочь с выбором ↗
    </a>
  </div>
  <div class="product-form-layout">
    <form data-application-form class="product-form">
      <section class="product-card" data-wizard-step="0">
        <span class="product-step">01 / ЗАДАЧА И УСЛОВИЯ</span>
        <h2>Для чего нужно финансирование?</h2>
        <label class="credit-field">
          <span>Тип финансирования</span>
          <select name="product" required></select>
        </label>
        <p class="field-help" data-product-description></p>
        <label class="credit-field">
          <span>Задача бизнеса</span>
          <textarea
            name="goal"
            rows="2"
            required
            minlength="3"
            maxlength="1000"
          >Закупить оборудование и развивать бизнес</textarea>
        </label>
        <div class="form-grid">
          <label class="credit-field">
            <span>Сумма / стоимость имущества, ₽</span>
            <input
              name="amount"
              type="number"
              value="1500000"
              min="100000"
              max="10000000"
              step="10000"
              required
            />
          </label>
          <label class="credit-field">
            <span>Срок, месяцев</span>
            <input
              name="months"
              type="number"
              value="24"
              min="6"
              max="36"
              required
            />
          </label>
        </div>
        <label class="credit-field" data-refinance hidden>
          <span>Замещаемый внешний платёж, ₽ / месяц</span>
          <input name="refinanced_payment" type="number" value="0" min="0" />
        </label>
      </section>
      <section class="product-card" data-wizard-step="1" hidden>
        <span class="product-step">02 / ДАННЫЕ БИЗНЕСА</span>
        <h2>Финансовая картина</h2>
        <p class="field-help">
          Все значения ниже — в месяц, кроме остатка и возраста бизнеса.
        </p>
        <div class="form-grid">
          <label class="credit-field">
            <span>ИНН компании</span>
            <input name="inn" readonly required />
          </label>
          <label class="credit-field">
            <span>Выручка, ₽</span>
            <input
              name="revenue"
              type="number"
              value="1500000"
              min="1"
              max="1000000000"
              required
            />
          </label>
          <label class="credit-field">
            <span>Операционные расходы, ₽</span>
            <input
              name="expenses"
              type="number"
              value="900000"
              min="0"
              max="1000000000"
              required
            />
          </label>
          <label class="credit-field">
            <span>Налоги, ₽</span>
            <input
              name="taxes"
              type="number"
              value="50000"
              min="0"
              max="1000000000"
              required
            />
          </label>
          <label class="credit-field">
            <span>Внешние кредитные платежи, ₽</span>
            <input
              name="debt"
              type="number"
              value="20000"
              min="0"
              max="1000000000"
              required
            />
          </label>
          <label class="credit-field">
            <span>Остаток денег, ₽</span>
            <input
              name="cash"
              type="number"
              value="500000"
              min="0"
              max="1000000000"
              required
            />
          </label>
          <label class="credit-field">
            <span>Возраст бизнеса, месяцев</span>
            <input
              name="age"
              type="number"
              value="36"
              min="0"
              max="1200"
              required
            />
          </label>
        </div>
      </section>
      <section class="product-card" data-wizard-step="2" hidden>
        <span class="product-step">03 / ДЕМОНСТРАЦИОННЫЕ ПРОВЕРКИ</span>
        <h2>Выберите тестовую ситуацию</h2>
        <label class="credit-field">
          <span>Пакет данных источников</span>
          <select name="scenario"></select>
        </label>
        <p class="field-help" data-scenario-description></p>
        <details class="demo-factor-panel">
          <summary>Собрать свой набор факторов</summary>
          <p class="field-help">
            Можно сочетать просрочку, налоги, сезонность и другие признаки. Они
            добавляются к выбранному пакету.
          </p>
          <div data-factors class="demo-factors"></div>
        </details>
        <div class="product-document-box">
          <span class="document-icon">↥</span>
          <div>
            <b>Документы по продукту</b>
            <p data-document-names></p>
            <button type="button" class="credit-text-link" data-attach>
              Приложить синтетический пакет в один клик
            </button>
            <span data-attached hidden class="product-green">
              ✓ Пакет приложен · синтетические данные
            </span>
            <div data-document-preview></div>
          </div>
        </div>
      </section>
      <section class="product-card" data-wizard-step="3" hidden>
        <span class="product-step">04 / СТРЕСС-СЦЕНАРИЙ</span>
        <h2>Что, если планы изменятся?</h2>
        <div class="form-grid">
          <label class="credit-field">
            <span>Падение выручки, %</span>
            <input
              name="stress_drop"
              type="number"
              min="0"
              max="80"
              value="20"
              required
            />
          </label>
          <label class="credit-field">
            <span>Задержка поступлений, месяцев</span>
            <input
              name="delay_months"
              type="number"
              min="0"
              max="3"
              value="0"
              required
            />
          </label>
        </div>
        <p class="field-help">
          Прогноз по введённым допущениям. Будущие доходы не гарантированы.
        </p>
      </section>
      <div class="product-form-actions">
        <button
          class="button button--secondary"
          type="button"
          data-wizard-back
          hidden
        >
          Назад
        </button>
        <button class="button button--primary" type="button" data-wizard-next>
          Продолжить →
        </button>
        <button
          class="button button--primary"
          type="submit"
          data-calculate
          hidden
        >
          Рассчитать условия и риски →
        </button>
        <button class="button button--secondary" type="button" data-save>
          Сохранить черновик
        </button>
      </div>
    </form>
    <aside class="product-form-summary">
      <nav class="application-stepper" aria-label="Этапы заявки">
        {["Условия", "Компания", "Проверки", "Прогноз"].map((label, i) => (
          <button
            type="button"
            data-wizard-go={i}
            disabled={i > 0}
            aria-current={i === 0 ? "step" : undefined}
          >
            <span>{i + 1}</span>
            <b>{label}</b>
          </button>
        ))}
      </nav>

      <details class="product-summary-details">
        <summary>Параметры заявки</summary>
        <div class="product-card">
          <span class="product-step">ВАША ЗАЯВКА</span>
          <h3 data-summary-company></h3>
          <div data-live-summary></div>
          <hr />
          <p class="field-help">
            Действующие обязательства будут учтены автоматически. Ставка и
            решение рассчитываются по данным компании.
          </p>
          <a class="credit-text-link" href="/cabinet/assistant/">
            Обсудить задачу с помощником →
          </a>
        </div>
      </details>
    </aside>
  </div>
  <section data-assessment hidden class="product-results"></section>
</Layout>
