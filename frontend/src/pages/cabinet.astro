---
import Layout from "../layouts/CabinetLayout.astro";
import Heading from "../components/cabinet/PageHeading.astro";
import RequestCard from "../components/cabinet/RequestCard.astro";
import { Button, Icon } from "../components/ui";
import { demoRequests } from "../data/cabinet";
---

<Layout title="Кредитные продукты">
  <Heading title="Кредитные продукты">
    <Button href="/cabinet/new/">Новая заявка</Button>
  </Heading>
  <nav class="credit-product-tabs" aria-label="Кредитные разделы">
    <a href="/cabinet/" aria-current="page">
      Мои заявки
    </a>
    <a href="/cabinet/documents/">Отправка документов</a>
    <a href="/cabinet/company/">Данные компании</a>
  </nav>
  <div class="credit-product-toolbar">
    <a class="credit-company-filter" href="/cabinet/company/">
      Компания: <strong data-sidebar-company>ООО «Пример роста»</strong>
      <Icon name="chevron" size={16} />
    </a>
    <a class="credit-neutral-filter" href="/cabinet/applications/">
      Все заявки <span data-total-count>3</span>
    </a>
  </div>
  <div class="credit-found">
    <span>
      На рассмотрении <strong data-review-count>1</strong>
    </span>
    <a href="/cabinet/applications/">Перейти ко всем заявкам →</a>
  </div>
  <h2 class="credit-list-caption">ФИНАНСИРОВАНИЕ БИЗНЕСА</h2>
  <div class="request-grid" data-dashboard-requests>
    {demoRequests.slice(0, 2).map((request) => (
      <RequestCard request={request} />
    ))}
  </div>
  <section class="credit-next-action">
    <div>
      <h2>Сделайте следующий шаг</h2>
      <p>Есть задача для бизнеса? Начните с подбора суммы, срока и условий.</p>
    </div>
    <Button href="/cabinet/new/">Подобрать финансирование</Button>
  </section>
</Layout>
