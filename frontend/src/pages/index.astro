---
import Layout from "../layouts/Layout.astro";
import {
  Button,
  Icon,
  PromoTile,
  ProductCard,
  SectionHeading,
  Tabs,
  Accordion,
  Badge,
} from "../components/ui";
import Calculator from "../components/sections/Calculator.astro";
import { products, faq } from "../data/products";
---

<Layout title="Банк для жизни и бизнеса">
  <div class="container home-content">
    <div class="demo-caption">
      <span>
        <i></i> Дизайн-демо
      </span>
      <a href="/components/">
        Собрано из Astro-компонентов <Icon name="arrow" size={14} />
      </a>
    </div>
    <section class="bento" aria-label="Предложения">
      <div class="bento-main">
        <article class="hero">
          <div class="hero-copy">
            <Badge>АЛЬФА — ДЛЯ ВСЕЙ СЕМЬИ</Badge>
            <h1>
              Карта для маленьких
              <br />
              супергероев
            </h1>
            <p>
              Бесплатная карта с любимыми
              <br />
              Леди Баг и Супер-Котом
            </p>
            <Button
              data-product="Детская карта — демонстрация оформления"
              size="lg"
            >
              Заказать карту
            </Button>
          </div>
        </article>
        <div class="bento-small">
          <PromoTile
            title="Кредит наличными"
            image="/assets/cash.png"
            href="#calculator"
          />
          <PromoTile
            title="Привилегии от Alfa Only"
            image="/assets/only.png"
            color="#e9e0ff"
          />
        </div>
      </div>
      <div class="bento-side">
        <PromoTile
          title="Та самая Альфа-Карта"
          image="/assets/debit.png"
          color="#e8eced"
        />
        <PromoTile
          title="Инвестиции — это просто"
          image="/assets/invest.png"
          color="#5297ff"
          href="#services"
        />
      </div>
    </section>
    <nav class="quick-nav" aria-label="Быстрый доступ">
      {[
        { icon: "wallet", label: "Выбрать карту", href: "#products" },
        { icon: "spark", label: "Получить кредит", href: "#calculator" },
        { icon: "shield", label: "Открыть вклад", href: "#products" },
        { icon: "user", label: "Для бизнеса", href: "/cabinet/" },
      ].map((x) => (
        <a href={x.href}>
          <span>
            <Icon name={x.icon} />
          </span>
          {x.label}
          <Icon name="chevron" size={16} />
        </a>
      ))}
    </nav>
    <section id="products" class="section">
      <div class="heading-row">
        <SectionHeading
          title="То, что нужно вам"
          description="Удобные решения для больших и маленьких планов"
        />
        <span class="muted small">Примеры продуктов</span>
      </div>
      <div class="product-grid">
        {products.map((x) => (
          <ProductCard {...x} />
        ))}
      </div>
    </section>
    <section class="business-banner section">
      <div>
        <p class="eyebrow">МАЛОМУ БИЗНЕСУ И ИП</p>
        <h2>
          Бизнес растёт.
          <br />
          Мы рядом.
        </h2>
        <p>
          От идеи до финансирования —<br />в одном кредитном кабинете.
        </p>
        <Button href="/cabinet/" size="lg">
          Найти решение для бизнеса <Icon name="arrow" size={18} />
        </Button>
      </div>
      <div class="business-art" aria-hidden="true">
        <div class="art-orbit"></div>
        <div class="art-card">
          <span class="alfa-mark">А</span>
          <span>business</span>
          <div class="card-chip"></div>
          <small>ДЛЯ БОЛЬШИХ ИДЕЙ</small>
        </div>
        <span class="art-coin">₽</span>
        <span class="art-star">✦</span>
      </div>
    </section>
    <Calculator />
    <section id="services" class="section">
      <SectionHeading
        title="Больше, чем банк"
        description="Полезное всегда под рукой"
      />
      <Tabs
        items={[
          { label: "Альфа-Мобайл", value: "mobile" },
          { label: "Путешествия", value: "travel" },
          { label: "Инвестиции", value: "invest" },
        ]}
      >
        <div slot="mobile" class="service-panel">
          <div>
            <p class="eyebrow">ВАШ БАНК В ТЕЛЕФОНЕ</p>
            <h3>
              Все возможности.
              <br />
              Одно приложение.
            </h3>
            <p>
              Переводы, платежи и ваши финансы —<br />
              там, где вам удобно.
            </p>
            <Button
              variant="secondary"
              data-product="Возможности приложения — демонстрационный раздел"
            >
              Посмотреть возможности <Icon name="arrow" size={18} />
            </Button>
          </div>
          <img
            src="/assets/app.png"
            alt="Иллюстрация мобильных сервисов Альфа-Банка"
            loading="lazy"
          />
        </div>
        <div slot="travel" class="service-panel service-panel--travel">
          <div>
            <p class="eyebrow">НОВЫЕ ВПЕЧАТЛЕНИЯ</p>
            <h3>
              Мир ближе,
              <br />
              чем кажется.
            </h3>
            <p>
              Спланируйте следующую поездку.
              <br />В демо показан пример сервисного баннера.
            </p>
            <Button data-product="Путешествия — демонстрация сервиса">
              Узнать больше ↗
            </Button>
          </div>
          <span class="service-symbol" aria-hidden="true">
            ↗
          </span>
        </div>
        <div slot="invest" class="service-panel service-panel--invest">
          <div>
            <p class="eyebrow">НАВСТРЕЧУ ВОЗМОЖНОСТЯМ</p>
            <h3>
              Ваш следующий шаг
              <br />в инвестициях.
            </h3>
            <p>
              Демонстрационный раздел.
              <br />
              Инвестиционные операции недоступны.
            </p>
            <Button data-product="Инвестиции — демонстрация сервиса">
              Посмотреть пример ↗
            </Button>
          </div>
          <img src="/assets/invest.png" alt="" loading="lazy" />
        </div>
      </Tabs>
    </section>
    <section id="faq" class="section faq-section">
      <SectionHeading
        title="Всё понятно"
        description="Ответы о прототипе и его возможностях"
      />
      <Accordion items={faq} />
    </section>
    <aside class="kit-banner">
      <div>
        <Badge>ASTRO UI KIT</Badge>
        <h3>Один стиль. Много возможностей.</h3>
        <p>Компоненты этого сайта — в отдельной интерактивной библиотеке.</p>
      </div>
      <Button href="/components/" variant="secondary">
        Открыть компоненты <Icon name="grid" size={18} />
      </Button>
    </aside>
  </div>
</Layout>
