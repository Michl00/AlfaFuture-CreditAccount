@base = http://localhost:8080

### Доступность и сценарии
GET {{base}}/api/v1/catalog

### Демовход; REST Client сохраняет cookie
# @name login
POST {{base}}/api/v1/demo/login
Content-Type: application/json

{"profile":"ooo"}

### Личность и CSRF
GET {{base}}/api/v1/me

### Оценка; скопировать fingerprint в запрос отправки либо использовать переменную
# @name assessment
POST {{base}}/api/v1/assessments
Content-Type: application/json
X-CSRF-Token: {{login.response.body.csrf}}

{"product":"working","amount":1500000,"months":24,"goal":"Закупка оборудования","inn":"7701234560","revenue":1500000,"expenses":900000,"taxes":50000,"debt":20000,"cash":500000,"age":36,"scenario":"clean","documents_attached":true,"stress_drop":20,"delay_months":0,"refinanced_payment":0}

### Поставить сохранённую оценку в очередь ИИ
POST {{base}}/api/v1/assessments/{{assessment.response.body.assessment_id}}/review
X-CSRF-Token: {{login.response.body.csrf}}

### Повторять до review_state=done либо unavailable; worker должен быть запущен
GET {{base}}/api/v1/assessments/{{assessment.response.body.assessment_id}}

### Подтверждение той же версии; при повторе использовать тот же Idempotency-Key
# @name application
POST {{base}}/api/v1/applications
Content-Type: application/json
X-CSRF-Token: {{login.response.body.csrf}}
Idempotency-Key: manual-demo-request-0001

{"data":{"product":"working","amount":1500000,"months":24,"goal":"Закупка оборудования","inn":"7701234560","revenue":1500000,"expenses":900000,"taxes":50000,"debt":20000,"cash":500000,"age":36,"scenario":"clean","documents_attached":true,"stress_drop":20,"delay_months":0,"refinanced_payment":0},"fingerprint":"{{assessment.response.body.fingerprint}}","assessment_id":"{{assessment.response.body.assessment_id}}","consent":true}

### Список и детали
GET {{base}}/api/v1/applications

### Версии заявки
GET {{base}}/api/v1/applications/{{application.response.body.id}}/revisions

### Чат
POST {{base}}/api/v1/chat
Content-Type: application/json
X-CSRF-Token: {{login.response.body.csrf}}

{"message":"Хочу купить оборудование. Составь короткий тест для выбора финансирования."}

### Выход отзывает сессию
POST {{base}}/api/v1/logout
X-CSRF-Token: {{login.response.body.csrf}}

### Демовход сотрудника
# @name staff
POST {{base}}/api/v1/demo/login
Content-Type: application/json

{"profile":"bank"}

### Рабочая очередь
GET {{base}}/api/v1/applications?status=in_review

### Оформление договора; version берётся из свежих деталей заявки
POST {{base}}/api/v1/applications/{{application.response.body.id}}/actions
Content-Type: application/json
X-CSRF-Token: {{staff.response.body.csrf}}

{"version":1,"action":"sign","comment":"Учебное оформление договора после проверки оснований","simulate_failure":false}

### Свежая версия после оформления
GET {{base}}/api/v1/applications/{{application.response.body.id}}

### Симуляция выдачи; version обновить из свежих деталей заявки
POST {{base}}/api/v1/applications/{{application.response.body.id}}/actions
Content-Type: application/json
X-CSRF-Token: {{staff.response.body.csrf}}

{"version":2,"action":"pay","comment":"Сотрудник проверил основания и запускает симуляцию","simulate_failure":false}
