# Generate a random JWT secret before starting the server.
SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
# Add the key only to the untracked .env or the server secret store.
COMETAPI_API_KEY=
# Exact API model ID from your CometAPI account, for Qwen3.8-Flash.
COMETAPI_MODEL=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
RESET_PASSWORD_URL=http://127.0.0.1:8000/demo?flow=reset
