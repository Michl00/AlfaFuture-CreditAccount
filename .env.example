# Generate a random JWT secret before starting the server.
SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
# Add the key only to the untracked .env or the server secret store.
COMETAPI_KEY=
# Model ID used for recommendations and risk assessment.
COMETAPI_MODEL=deepseek-v4.1-flash
# Total request deadline, including a possible JSON-mode retry (30–300 seconds).
COMETAPI_TIMEOUT_SECONDS=180
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
RESET_PASSWORD_URL=http://127.0.0.1:8000/demo?flow=reset

# Autonomous product: no paid keys needed.
DEMO_MODE=true
DATABASE_URL=sqlite+aiosqlite:///./app.db
ASSISTANT_MODEL=qwen3-235b-a22b
