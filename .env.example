# Generate a random JWT secret before starting the server.
SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
# OpenAI-compatible provider. Keep credentials in .env or the server secret store.
ASSISTANT_PROVIDER=comet

PROVIDER=cometapi
# API root including /v1 when required, e.g. https://your-provider.example/v1
PROVIDER_BASE_URL=https://api.cometapi.com/v1
PROVIDER_API_KEY=
PROVIDER_MODEL=deepseek-v4.1-flash
# Total request deadline for the legacy API (30–300 seconds).
PROVIDER_TIMEOUT_SECONDS=180
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
RESET_PASSWORD_URL=http://127.0.0.1:8000/demo?flow=reset

# Autonomous product: no paid keys needed.
DEMO_MODE=true
DATABASE_URL=sqlite+aiosqlite:///./app.db
# Optional assistant model override; defaults to PROVIDER_MODEL.
ASSISTANT_MODEL=qwen3-235b-a22b

DEMO_MODE=true
